<script>
    (function () {
        var toggle = document.getElementById('mobileNavToggle');
        var nav = document.getElementById('header-navbar');
        var overlay = document.getElementById('nav-overlay');

        function openNav() {
            nav.classList.add('mobile-open');
            overlay.classList.add('active');
            toggle.querySelector('i').classList.replace('bi-list', 'bi-x');
            toggle.setAttribute('aria-expanded', 'true');
            toggle.setAttribute('aria-label', 'Fermer le menu');
        }

        function closeNav() {
            nav.classList.remove('mobile-open');
            overlay.classList.remove('active');
            toggle.querySelector('i').classList.replace('bi-x', 'bi-list');
            toggle.setAttribute('aria-expanded', 'false');
            toggle.setAttribute('aria-label', 'Ouvrir le menu');
        }

        toggle.addEventListener('click', function () {
            nav.classList.contains('mobile-open') ? closeNav() : openNav();
        });

        overlay.addEventListener('click', closeNav);

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && nav.classList.contains('mobile-open')) {
                closeNav();
                toggle.focus();
            }
        });

        nav.querySelectorAll('.nav-link').forEach(function (link) {
            link.addEventListener('click', closeNav);
        });
    })();
</script>
