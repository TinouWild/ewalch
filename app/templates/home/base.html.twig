<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {# ── Google Analytics ────────────────────────────────────────────────── #}
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5S1BBC6WZ1"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-5S1BBC6WZ1');
    </script>

    {# ── Titre & meta description ─────────────────────────────────────────── #}
    {# Les URL absolues utilisent site_url (SITE_URL, https) et non le schéma de la requête #}
    <title>{% block title %}Etienne Walch — Développeur web freelance à Mulhouse | Sites et outils sur mesure{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Sites et outils métier sur mesure, livrés rapidement grâce à l'IA, par un développeur expérimenté basé à Mulhouse. Premier échange gratuit et sans engagement.{% endblock %}">

    {# ── Canonique ────────────────────────────────────────────────────────── #}
    <link rel="canonical" href="{% block canonical %}{{ site_url }}{{ path('app_home_index') }}{% endblock %}">

    {# ── Open Graph ───────────────────────────────────────────────────────── #}
    <meta property="og:type"        content="{% block og_type %}website{% endblock %}">
    <meta property="og:url"         content="{% block og_url %}{{ site_url }}{{ path('app_home_index') }}{% endblock %}">
    <meta property="og:title"       content="{% block og_title %}Etienne Walch — Votre site ou outil métier sur mesure{% endblock %}">
    <meta property="og:description" content="{% block og_description %}Sites et outils métier sur mesure, livrés en quelques semaines grâce à l'IA, par un développeur expérimenté basé à Mulhouse.{% endblock %}">
    <meta property="og:image"       content="{% block og_image %}{{ site_url }}{{ asset('images/portrait-1200.jpg') }}{% endblock %}">
    <meta property="og:image:alt"   content="Portrait d'Etienne Walch, développeur web freelance à Mulhouse">
    <meta property="og:locale"      content="fr_FR">
    <meta property="og:site_name"   content="Etienne Walch">

    {# ── Twitter Card ─────────────────────────────────────────────────────── #}
    <meta name="twitter:card"        content="summary">
    <meta name="twitter:title"       content="{% block twitter_title %}Etienne Walch — Votre site ou outil métier sur mesure{% endblock %}">
    <meta name="twitter:description" content="{% block twitter_description %}Sites et outils métier sur mesure, livrés rapidement grâce à l'IA, par un développeur expérimenté basé à Mulhouse.{% endblock %}">
    <meta name="twitter:image"       content="{% block twitter_image %}{{ site_url }}{{ asset('images/portrait-1200.jpg') }}{% endblock %}">

    {# ── Données structurées JSON-LD ──────────────────────────────────────── #}
    {% block structured_data %}
    {# À COMPLÉTER : ajouter "https://www.instagram.com/etienne_walch/" à sameAs si le lien Instagram est conservé #}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "Person",
                "@id": "{{ site_url }}/#person",
                "name": "Etienne Walch",
                "jobTitle": "Développeur web freelance",
                "description": "Développeur web freelance basé à Mulhouse, avec plus de 5 ans d'expérience. Ancien enseignant, il conçoit des sites et outils métier sur mesure pour les TPE, PME, artisans et indépendants, en s'appuyant sur l'IA pour livrer plus vite.",
                "url": "{{ site_url }}/",
                "image": "{{ site_url }}{{ asset('images/portrait-1200.jpg') }}",
                "address": {
                    "@type": "PostalAddress",
                    "addressLocality": "Mulhouse",
                    "addressRegion": "Alsace",
                    "addressCountry": "FR"
                },
                "sameAs": [
                    "https://www.linkedin.com/in/etienne-walch-07683216b/"
                ],
                "knowsAbout": ["Développement web", "Applications métier", "API", "PHP", "Symfony", "Intelligence artificielle", "Claude Code"]
            },
            {
                "@type": "WebSite",
                "@id": "{{ site_url }}/#website",
                "url": "{{ site_url }}/",
                "name": "Etienne Walch — Développeur web freelance à Mulhouse",
                "inLanguage": "fr-FR",
                "author": { "@id": "{{ site_url }}/#person" }
            },
            {
                "@type": "ProfessionalService",
                "@id": "{{ site_url }}/#service",
                "name": "Etienne Walch — Sites et outils métier sur mesure",
                "description": "Sites et outils métier sur mesure, livrés rapidement grâce à l'IA, par un développeur expérimenté basé à Mulhouse : back-office, portail client, prise de commande, automatisation, reprise de projets IA bloqués, maintenance.",
                "url": "{{ site_url }}/",
                "image": "{{ site_url }}{{ asset('images/portrait-1200.jpg') }}",
                "founder": { "@id": "{{ site_url }}/#person" },
                "address": {
                    "@type": "PostalAddress",
                    "addressLocality": "Mulhouse",
                    "addressRegion": "Alsace",
                    "addressCountry": "FR"
                },
                "areaServed": [
                    { "@type": "City", "name": "Mulhouse", "sameAs": "https://www.wikidata.org/wiki/Q5715" },
                    { "@type": "AdministrativeArea", "name": "Alsace" },
                    { "@type": "Country", "name": "France" }
                ],
                "sameAs": [
                    "https://www.linkedin.com/in/etienne-walch-07683216b/"
                ],
                "hasOfferCatalog": {
                    "@type": "OfferCatalog",
                    "name": "Prestations",
                    "itemListElement": [
                        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Diagnostic de projet", "description": "Analyse de votre besoin ou de votre projet existant, avec un plan clair et chiffré, sans engagement." } },
                        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Site ou outil métier sur mesure", "description": "Site, prise de commande, back-office, portail client, automatisation, à prix fixe défini avant de commencer." } },
                        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Reprise de projet créé avec l'IA", "description": "Correction, sécurisation et mise en ligne de sites ou applications commencés avec ChatGPT, Claude, Lovable ou Bolt." } },
                        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Suivi mensuel et maintenance", "description": "Hébergement, mises à jour, sécurité et petites évolutions." } }
                    ]
                }
            }
        ]
    }
    </script>
    {% endblock %}

    {# ── Favicon ──────────────────────────────────────────────────────────── #}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">

    {# ── CSS ──────────────────────────────────────────────────────────────── #}
    {% block stylesheets %}{% endblock %}

    {# Bootstrap Icons — non-bloquant #}
    <link rel="preload" as="style"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css"
          onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
    </noscript>

    {% block javascripts %}{% endblock %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>

<body class="vitrine">
<button id="backToTopBtn" type="button" title="Retour en haut" aria-label="Retour en haut de la page"><i class="bi bi-caret-up-fill" aria-hidden="true"></i></button>
{% include 'partials/_flash_messages.html.twig' %}
{% block body %}{% endblock %}
</body>
</html>
