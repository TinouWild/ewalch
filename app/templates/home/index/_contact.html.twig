<section id="contact" class="contact" aria-labelledby="contact-title">
    <div class="container">
        <div class="section-title">
            <h2 id="contact-title">Parlons de votre projet</h2>
            <p class="contact-promesse">
                <i class="bi bi-clock me-2" aria-hidden="true"></i>Réponse sous 24&nbsp;h. Le premier échange est
                gratuit et sans engagement.
            </p>
        </div>
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="contact-form">
                    {{ form_start(contactForm) }}
                    <fieldset>
                        <legend class="visually-hidden">Formulaire de contact</legend>
                        <div class="row g-3">
                            <div class="col-md-6">
                                {{ form_row(contactForm.email) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(contactForm.need) }}
                            </div>
                        </div>
                        {{ form_row(contactForm.object) }}
                        {{ form_row(contactForm.message, {'id': 'autoResizeTextarea'}) }}
                        <div class="text-end">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-send me-2" aria-hidden="true"></i>Envoyer
                            </button>
                        </div>
                    </fieldset>
                    {{ form_end(contactForm) }}
                </div>
            </div>
            <div class="col-lg-4">
                <div class="contact-alternatives">
                    <p class="mb-3">Vous préférez un contact direct&nbsp;?</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="https://www.linkedin.com/in/etienne-walch-07683216b/" target="_blank" rel="noopener" class="btn btn-primary">
                            <i class="bi bi-linkedin me-2" aria-hidden="true"></i>LinkedIn<span class="visually-hidden"> (nouvel onglet)</span>
                        </a>
                        <a href="https://www.instagram.com/etienne_walch/" target="_blank" rel="noopener" class="btn btn-outline-dark">
                            <i class="bi bi-instagram me-2" aria-hidden="true"></i>Instagram<span class="visually-hidden"> (nouvel onglet)</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
