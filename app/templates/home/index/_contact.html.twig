<section id="contact" class="contact">
    <div class="section-title">
        <h2 class="text-black">Contact</h2>
    </div>
    <div class="container">
        {{ form_start(contactForm) }}
        <fieldset>
            <div class="form-group">
                {{ form_row(contactForm.email) }}
                <small class="form-text text-muted">Votre adresse email ne sera pas partagée, ni conservée.</small>
            </div>
            <div class="form-group mt-3">
                {{ form_row(contactForm.object) }}
            </div>
            <div class="form-group mt-3">
                <label class="form-label">Votre message :</label>
                {{ form_row(contactForm.message, {'id': 'autoResizeTextarea'}) }}
            </div>
            <button type="submit" class="btn btn-primary mt-3 float-end">Envoyer</button>
        </fieldset>
        {{ form_end(contactForm) }}

        <div class="contact-alternatives mt-5 pt-4 border-top">
            <p class="text-muted mb-3">Vous préférez un contact direct ?</p>
            <div class="d-flex flex-wrap gap-3">
                <a href="https://www.linkedin.com/in/etienne-walch-07683216b/" target="_blank" class="btn btn-outline-primary">
                    <i class="bi bi-linkedin me-2"></i>LinkedIn
                </a>
                <a href="https://www.instagram.com/etienne_walch/" target="_blank" class="btn btn-outline-secondary">
                    <i class="bi bi-instagram me-2"></i>Instagram
                </a>
            </div>
        </div>
    </div>
</section>
