{% extends '/home/base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <div class="container-fluid">
        {% include '/partials/_navbar.html.twig' %}

        <section id="etienne" class="d-flex flex-column justify-content-center align-items-center vh-100">
            <div class="etienne-container" data-aos="fade-in">
                <h1>Etienne Walch</h1>
                <span id="dev-typed"></span>
                <p class="hero-tagline">Je conçois des applications web sur mesure, performantes et adaptées à vos besoins.</p>
                <div class="hero-cta mt-4">
                    <a href="#portfolio" class="btn btn-primary me-3">Voir mes projets</a>
                    <a href="#contact" class="btn btn-outline-light">Me contacter</a>
                </div>
            </div>
        </section>

        <main id="main">
            {% include 'home/index/_apropos.html.twig' %}
            {% include 'home/index/_portfolio.html.twig' %}
            {% include 'home/index/_demo.html.twig' %}
            {% include 'home/index/_experiences.html.twig' %}
            {% include 'home/index/_contact.html.twig' %}
        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var typed = new Typed("#dev-typed", {
                strings: [
                    "Développeur PHP/Symfony",
                    "Développeur freelance",
                    "Expert API Platform",
                    "Développeur web sur mesure"
                ],
                typeSpeed: 50,
                backSpeed: 25,
                backDelay: 2000,
                loop: true
            });
        });
    </script>
{% endblock %}
