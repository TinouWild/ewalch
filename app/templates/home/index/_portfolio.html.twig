<section id="portfolio" class="portfolio" aria-labelledby="portfolio-title">
    <div class="container">
        <div class="section-title">
            <h2 id="portfolio-title">Réalisations</h2>
            <p>Des projets concrets, pour des personnes qui avaient chacune un besoin bien à elles.</p>
        </div>
        <div class="row g-4">
            {% set projets = [
                {
                    'id': 'fitcookies',
                    'nom': 'Les fit cookies de la petite Marie',
                    'url': 'https://lesfitcookiesdelapetitemarie.fr',
                    'isActive': true,
                    'image': 'fitcookies',
                    'alt': "Page d'accueil de la boutique en ligne Les fit cookies de la petite Marie",
                    'resultat': "Une créatrice qui vend désormais en ligne, en toute autonomie.",
                    'texte': "Ses clients commandent et paient en ligne en toute sécurité, les factures sont générées automatiquement, et elle suit ses commandes et ses clients depuis son propre espace d'administration.",
                    'badges': ['Boutique en ligne', 'Paiement Stripe', 'Back-office'],
                    'modale': 'home/portfolio/fitcookiesmodal.html.twig',
                },
                {
                    'id': 'titine',
                    'nom': 'Titine Créations',
                    'url': 'https://titine-creations.fr',
                    'isActive': true,
                    'image': 'titine',
                    'alt': "Galerie en ligne de Titine Créations présentant des peintures réalisées au couteau",
                    'resultat': "Une artiste qui expose et gère elle-même ses œuvres en ligne.",
                    'texte': "Elle peint au couteau, d'une seule main. Son site met ses tableaux en valeur, et c'est elle qui choisit, depuis son espace, les œuvres visibles par le public.",
                    'badges': ['Galerie', 'Gestion de contenu', 'Back-office'],
                    'modale': 'home/portfolio/titinemodal.html.twig',
                },
                {
                    'id': 'scoringames',
                    'nom': 'Scoringames',
                    'url': 'https://scoringames.com',
                    'isActive': false,
                    'image': 'scoringames',
                    'alt': "Page d'accueil de la plateforme communautaire Scoringames dédiée aux jeux de société",
                    'resultat': "Une plateforme communautaire complète pour les passionnés de jeux de société.",
                    'texte': "Les membres ont leur compte, gèrent leur ludothèque et gagnent des points en participant. L'équipe publie ses articles et ajoute de nouveaux jeux en toute autonomie.",
                    'badges': ['Comptes membres', 'Système de points', 'Publication d\'articles'],
                    'modale': 'home/portfolio/scoringames.html.twig',
                },
            ] %}
            {% for projet in projets %}
                <div class="col-lg-4">
                    <article class="projet-card h-100" aria-labelledby="projet-{{ projet.id }}-titre">
                        <picture>
                            <source type="image/webp"
                                    srcset="{{ asset('images/' ~ projet.image ~ '-480.webp') }} 480w, {{ asset('images/' ~ projet.image ~ '-960.webp') }} 960w"
                                    sizes="(min-width: 992px) 30vw, 100vw">
                            <img src="{{ asset('images/' ~ projet.image ~ '-960.jpg') }}" alt="{{ projet.alt }}"
                                 width="960" height="{{ projet.image == 'scoringames' ? 600 : 540 }}"
                                 loading="lazy" decoding="async" class="img-fluid projet-image">
                        </picture>
                        <div class="projet-body">
                            <h3 id="projet-{{ projet.id }}-titre">{{ projet.nom }}</h3>
                            <p class="projet-resultat">{{ projet.resultat }}</p>
                            <p>{{ projet.texte }}</p>
                            <ul class="projet-badges" aria-label="Ce qui a été mis en place">
                                {% for badge in projet.badges %}
                                    <li>{{ badge }}</li>
                                {% endfor %}
                            </ul>
                            <div class="projet-actions">
                                <button type="button" class="btn btn-dark" data-bs-toggle="modal"
                                        data-bs-target="#{{ projet.id }}modal">
                                    En savoir plus<span class="visually-hidden"> sur {{ projet.nom }}</span>
                                </button>
                                {% if projet.isActive ?? true %}
                                    <a href="{{ projet.url }}" target="_blank" rel="noopener" class="btn btn-outline-dark">
                                        Voir le site<span class="visually-hidden"> {{ projet.nom }} (nouvel onglet)</span>
                                        <i class="bi bi-box-arrow-up-right ms-1" aria-hidden="true"></i>
                                    </a>
                                {% else %}
                                    <button type="button" class="btn btn-outline-dark" disabled>
                                        Voir le site<span class="visually-hidden"> {{ projet.nom }} (site actuellement hors ligne)</span>
                                        <i class="bi bi-box-arrow-up-right ms-1" aria-hidden="true"></i>
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                    </article>
                    {% include projet.modale %}
                </div>
            {% endfor %}
        </div>
    </div>
</section>
