<section id="demo" class="demo" aria-labelledby="demo-title">
    <div class="container">
        <div class="section-title">
            <h2 id="demo-title">Démo</h2>
            <p>
                Envie de voir à quoi pourrait ressembler votre futur outil&nbsp;? L'espace de démonstration
                regroupe des fonctionnalités que je peux intégrer à votre projet.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                {% set usages = [
                    { 'icone': 'bi-lock',                   'titre': "Chacun accède à ce qui le concerne",            'detail': 'Authentification & rôles' },
                    { 'icone': 'bi-table',                  'titre': 'Gérer vos clients, produits ou dossiers',       'detail': 'Formulaires de gestion' },
                    { 'icone': 'bi-funnel',                 'titre': 'Retrouver une information en quelques secondes', 'detail': 'Filtres & pagination' },
                    { 'icone': 'bi-envelope',               'titre': 'Relances et confirmations envoyées automatiquement', 'detail': 'Emails automatisés' },
                    { 'icone': 'bi-file-earmark-arrow-down', 'titre': 'Vos données exportées pour votre comptable',   'detail': 'Export CSV / Excel' },
                    { 'icone': 'bi-graph-up',               'titre': "Votre activité d'un coup d'œil",                'detail': 'Tableau de bord' },
                ] %}
                <ul class="row g-3 list-unstyled mb-0">
                    {% for usage in usages %}
                        <li class="col-sm-6">
                            <div class="demo-feature d-flex align-items-start gap-3 p-3 rounded h-100">
                                <i class="bi {{ usage.icone }} fs-4" aria-hidden="true"></i>
                                <div>
                                    <span class="demo-feature-titre">{{ usage.titre }}</span>
                                    <span class="demo-feature-detail">{{ usage.detail }}</span>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <div class="col-lg-5">
                <div class="demo-acces h-100">
                    <h3>Demander un accès</h3>
                    <p class="text-muted small mb-3">Accès gratuit, réponse sous 24&nbsp;h.</p>
                    {{ form_start(demoForm) }}
                    <fieldset>
                        <div class="form-group">
                            {{ form_row(demoForm.email, {'label': 'Votre adresse email'}) }}
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mt-2">
                            <i class="bi bi-send me-2" aria-hidden="true"></i>Demander un accès
                        </button>
                    </fieldset>
                    {{ form_end(demoForm) }}
                    <p class="text-muted small mt-3 mb-0">
                        <i class="bi bi-shield-check me-1" aria-hidden="true"></i>Votre email ne sera pas partagé.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
