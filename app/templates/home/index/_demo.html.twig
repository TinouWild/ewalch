<section id="demo" class="demo">
    <div class="section-title">
        <h2 class="text-black">Démo</h2>
    </div>

    <div class="row g-4 mx-md-3 mb-3">
        <div class="col-md-7">
            <p class="mb-3">
                Vous voulez voir ce que je sais faire avant de me contacter ? L'espace de démo regroupe des
                fonctionnalités typiques d'une application web PHP/Symfony que je peux intégrer à votre projet.
            </p>
            <div class="row g-2">
                <div class="col-6">
                    <div class="demo-feature d-flex align-items-center gap-2 p-2 rounded border">
                        <i class="bi bi-lock text-primary fs-5"></i>
                        <span class="small">Authentification & rôles</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="demo-feature d-flex align-items-center gap-2 p-2 rounded border">
                        <i class="bi bi-table text-primary fs-5"></i>
                        <span class="small">CRUD avec formulaires</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="demo-feature d-flex align-items-center gap-2 p-2 rounded border">
                        <i class="bi bi-funnel text-primary fs-5"></i>
                        <span class="small">Filtres & pagination</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="demo-feature d-flex align-items-center gap-2 p-2 rounded border">
                        <i class="bi bi-envelope text-primary fs-5"></i>
                        <span class="small">Emails automatisés</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="demo-feature d-flex align-items-center gap-2 p-2 rounded border">
                        <i class="bi bi-file-earmark-arrow-down text-primary fs-5"></i>
                        <span class="small">Export CSV / Excel</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="demo-feature d-flex align-items-center gap-2 p-2 rounded border">
                        <i class="bi bi-graph-up text-primary fs-5"></i>
                        <span class="small">Tableau de bord</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card border-primary h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-1">Demander un accès</h5>
                        <p class="text-muted small mb-3">Accès gratuit — réponse sous 24 h</p>
                        {{ form_start(demoForm) }}
                        <fieldset>
                            <div class="form-group">
                                {{ form_row(demoForm.email) }}
                            </div>
                            <button type="submit" class="btn btn-primary w-100 mt-3">
                                <i class="bi bi-send me-2"></i>Demander un accès
                            </button>
                        </fieldset>
                        {{ form_end(demoForm) }}
                    </div>
                    <p class="text-muted small mt-3 mb-0">
                        <i class="bi bi-shield-check me-1"></i>Votre email ne sera pas partagé.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
