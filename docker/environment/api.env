# Template versionné — valeurs par défaut / placeholders.
# Pour le dev local, créer docker/environment/api.env.local (ignoré par git)
# et y mettre les vrais secrets (APP_SECRET, BREVO_API_KEY...).
# Les variables de api.env.local surchargent celles-ci.
SHELL_VERBOSITY=0
APP_DEBUG=true
APP_ENV=dev
APP_SECRET=change_me
BREVO_API_KEY=
